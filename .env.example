# See src/config/env.ts (Zod schema) for the authoritative list — the
# process exits on invalid/missing config. See README.md for a
# description of each var.

NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://adopta:adopta@localhost:5432/adopta
DATABASE_POOL_MAX=10
AUTH_SECRET=dev-secret-change-me-please-32chars
PUBLIC_ORIGIN=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
LOG_LEVEL=info
SEED_SCENARIO=demo
SEED_IMAGE_MODE=ingest
