{
  "name": "adopta-api",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.0",
  "imports": {
    "#contracts": "./src/contracts/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "validate": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/seed/index.ts",
    "db:reset": "tsx src/seed/index.ts --reset",
    "sweep:uploads": "tsx src/scripts/sweep-uploads.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@hono/node-server": "^1.13.8",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.1",
    "hono": "^4.6.14",
    "neverthrow": "^8.2.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "sharp": "^0.33.5",
    "uuid": "^11.0.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
