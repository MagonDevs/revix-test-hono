    "hono": "^4.6.14",
    "neverthrow": "^8.2.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "sharp": "^0.33.5",
    "superjson": "^2.2.2",
    "uuid": "^11.0.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@adopta/eslint-config": "workspace:*",
    "@adopta/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.18.0",
